{
  "$schema": "https://paseo.sh/schemas/paseo.config.v1.json",
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "relay": {
      "enabled": false
    }
  },
  "pluginsEnabled": true,
  "plugins": {
    "task-diffs": {
      "source": "directory",
      "path": "/workspace/personal/agents/paseo-plugins/task-diffs",
      "enabled": true
    },
    "enterprise-usage": {
      "source": "directory",
      "path": "/workspace/personal/agents/paseo-plugins/enterprise-usage",
      "enabled": true
    }
  },
  "worktrees": {
    "root": "/workspace/.paseo/worktrees"
  },
  "agents": {
    "providers": {
      "claude": {
        "command": [
          "/workspace/personal/dotfiles/bin/paseo-claude"
        ],
        "models": [
          {
            "id": "claude-opus-5-5",
            "label": "Opus 5.5",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "low",
                "label": "Low"
              },
              {
                "id": "medium",
                "label": "Medium",
                "isDefault": true
              },
              {
                "id": "high",
                "label": "High"
              },
              {
                "id": "xhigh",
                "label": "Extra High"
              },
              {
                "id": "max",
                "label": "Max"
              }
            ]
          },
          {
            "id": "claude-fable-5-2",
