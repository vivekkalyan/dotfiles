#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: dev-pod-kubeconfig-sync [options] CONTEXT [CONTEXT ...]

Create or update the dev pod's kubeconfig Secret from selected local contexts.
Context names and credentials are sent directly to Kubernetes and are not
written into the dotfiles repository.

Options:
  --host-context CONTEXT  Context containing the dev pod; defaults to the first CONTEXT.
  --kubeconfig FILE       Source kubeconfig; defaults to ~/.kube/config.
  --namespace NAMESPACE   Secret namespace; defaults to default.
  --secret NAME           Secret name; defaults to vivek-dev-kubeconfig.
  --check                 Validate the selected contexts without updating the Secret.
  -h, --help              Show this help.
EOF
}

source_config="${HOME}/.kube/config"
host_context=""
namespace="default"
secret_name="vivek-dev-kubeconfig"
mode="apply"
contexts=()

while [ "$#" -gt 0 ]; do
  case "$1" in
    --host-context)
      host_context="${2:?missing value for --host-context}"
      shift 2
      ;;
    --kubeconfig)
      source_config="${2:?missing value for --kubeconfig}"
      shift 2
      ;;
    --namespace)
      namespace="${2:?missing value for --namespace}"
      shift 2
      ;;
    --secret)
      secret_name="${2:?missing value for --secret}"
      shift 2
      ;;
    --check)
      mode="check"
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      echo "dev-pod-kubeconfig-sync: unknown option: $1" >&2
      usage >&2
      exit 2
      ;;
    *)
      contexts+=("$1")
      shift
      ;;
  esac
done

if [ "${#contexts[@]}" -eq 0 ]; then
  echo "dev-pod-kubeconfig-sync: provide at least one context" >&2
  usage >&2
  exit 2
fi

if [ -z "$host_context" ]; then
  host_context="${contexts[0]}"
fi

if [ ! -r "$source_config" ]; then
  echo "dev-pod-kubeconfig-sync: cannot read kubeconfig: $source_config" >&2
  exit 1
fi

if ! command -v kubectl >/dev/null 2>&1; then
  echo "dev-pod-kubeconfig-sync: kubectl is required" >&2
  exit 1
fi

umask 077
temp_dir="$(mktemp -d "${TMPDIR:-/tmp}/dev-pod-kubeconfig.XXXXXX")"
trap 'rm -rf -- "$temp_dir"' EXIT

merge_paths=""
index=0
for context in "${contexts[@]}"; do
  if ! kubectl --kubeconfig="$source_config" config get-contexts "$context" -o name | grep -Fxq "$context"; then
    echo "dev-pod-kubeconfig-sync: context not found: $context" >&2
    exit 1
  fi

  context_config="$temp_dir/context-$index"
  kubectl --kubeconfig="$source_config" --context="$context" \
    config view --raw --flatten --minify > "$context_config"
  merge_paths="${merge_paths:+$merge_paths:}$context_config"
  index=$((index + 1))
done

bundle="$temp_dir/config"
KUBECONFIG="$merge_paths" kubectl config view --raw --flatten > "$bundle"

context_count="$(KUBECONFIG="$bundle" kubectl config get-contexts -o name | wc -l | tr -d ' ')"
if [ "$context_count" -ne "${#contexts[@]}" ]; then
  echo "dev-pod-kubeconfig-sync: expected ${#contexts[@]} contexts, found $context_count" >&2
  exit 1
fi

if [ "$mode" = "check" ]; then
  echo "Validated ${#contexts[@]} context(s); Secret was not updated."
  exit 0
fi

kubectl --kubeconfig="$source_config" --context="$host_context" \
  --namespace="$namespace" create secret generic "$secret_name" \
  --from-file=config="$bundle" \
  --dry-run=client -o yaml \
| kubectl --kubeconfig="$source_config" --context="$host_context" \
    --namespace="$namespace" apply -f -

echo "Updated Secret/$secret_name in namespace $namespace."
echo "Included ${#contexts[@]} context(s)."
